<Window x:Class="FocusGuard.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:FocusGuard.UI.Converters"
        Title="Whitelist Lock In" Height="800" Width="1160" MinHeight="650" MinWidth="840"
        Background="{DynamicResource BgBrush}" WindowStartupLocation="CenterScreen" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <converters:ExecutableIconConverter x:Key="ExecutableIcon"/>
        <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="{DynamicResource PanelBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="13"/><Setter Property="Padding" Value="20"/></Style>
        <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="FontSize" Value="13"/></Style>
        <Style x:Key="NavButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Padding" Value="13,10"/><Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="14"/><Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="NavBg" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="NavBg" Property="Background" Value="{DynamicResource HoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></Trigger><Trigger Property="IsPressed" Value="True"><Setter TargetName="NavBg" Property="Background" Value="{DynamicResource SelectedBrush}"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Focus"/><Condition Binding="{Binding CommandParameter, RelativeSource={RelativeSource Self}}" Value="Focus"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Websites"/><Condition Binding="{Binding CommandParameter, RelativeSource={RelativeSource Self}}" Value="Websites"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></MultiDataTrigger><MultiDataTrigger><MultiDataTrigger.Conditions><Condition Binding="{Binding DataContext.SelectedSection, RelativeSource={RelativeSource AncestorType=Window}}" Value="Settings"/><Condition Binding="{Binding CommandParameter, RelativeSource={RelativeSource Self}}" Value="Settings"/></MultiDataTrigger.Conditions><Setter Property="Background" Value="{DynamicResource SelectedBrush}"/><Setter Property="Foreground" Value="{DynamicResource InkBrush}"/></MultiDataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="10,6"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="228"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0" Padding="17,22">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Margin="4,0,4,32">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="34" Height="34" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,11,0"><TextBlock Text="W" Foreground="White" FontSize="17" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel VerticalAlignment="Center"><TextBlock Text="Whitelist" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="LOCK IN" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="0,1,0,0"/></StackPanel></StackPanel>
                </StackPanel>
                <StackPanel DockPanel.Dock="Bottom" Margin="4,20,4,0">
                    <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="0,0,0,14"/>
                    <TextBlock Text="BROWSER CONNECTION" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="10,0,0,9"/>
                    <StackPanel Orientation="Horizontal" Margin="10,0,0,0"><Ellipse Width="7" Height="7" VerticalAlignment="Center" Margin="0,0,8,0"><Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="#D6A04B"/><Style.Triggers><DataTrigger Binding="{Binding IsExtensionConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource SuccessBrush}"/></DataTrigger></Style.Triggers></Style></Ellipse.Style></Ellipse><TextBlock Text="{Binding ExtensionStatusText}" Style="{StaticResource Muted}" FontSize="11"/></StackPanel>
                </StackPanel>
                <StackPanel>
                    <TextBlock Text="WORKSPACE" Foreground="{DynamicResource MutedBrush}" FontSize="9" FontWeight="Bold" Margin="10,0,0,8"/>
                    <Button Content="Focus" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Focus"/>
                    <Button Content="Websites" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Websites"/>
                    <Button Content="Settings" Style="{StaticResource NavButton}" Command="{Binding NavigateCommand}" CommandParameter="Settings"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="30,25,30,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Grid Grid.Row="0" Margin="0,0,0,21">
                <StackPanel><TextBlock Text="{Binding SelectedSection}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Make room for the work that matters." Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel>
                <Border HorizontalAlignment="Right" VerticalAlignment="Center" Background="{DynamicResource SelectedBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="11,7"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBlock Text="{Binding ActiveSessionName}" FontSize="12" FontWeight="SemiBold"/></StackPanel></Border>
            </Grid>
            <ScrollViewer x:Name="PageScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False" Padding="0,0,8,5" Focusable="False">
                <Grid>
                    <StackPanel Visibility="{Binding IsFocusSelected, Converter={StaticResource BoolToVisibility}}">
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,16,0"><TextBlock Text="Your focus session" FontSize="17" FontWeight="SemiBold"/><TextBlock Text="{Binding SessionStatusText}" Style="{StaticResource Muted}" Margin="0,5,0,0" TextWrapping="Wrap"/></StackPanel>
                                <StackPanel Grid.Column="1" HorizontalAlignment="Right"><TextBlock Text="{Binding RemainingText}" FontSize="29" FontWeight="SemiBold" HorizontalAlignment="Right" Foreground="{DynamicResource AccentLightBrush}"/><WrapPanel HorizontalAlignment="Right" Margin="0,9,0,0"><TextBox Text="{Binding DurationMinutes, UpdateSourceTrigger=PropertyChanged}" Width="82" HorizontalContentAlignment="Center" ToolTip="Session length in minutes (5–720)"/><TextBlock Text="minutes" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,12,0"/><Button Content="Start focus" Command="{Binding StartSessionCommand}"/><Button Content="End session" Command="{Binding EndSessionCommand}" Background="{DynamicResource DangerBrush}" Margin="0"/></WrapPanel></StackPanel>
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource Card}" Padding="13" Margin="0,0,0,20"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="150"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="Saved setup" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0"/><ComboBox Grid.Column="1" ItemsSource="{Binding Profiles}" DisplayMemberPath="Name" SelectedItem="{Binding SelectedProfile}" ToolTip="Choose an app and website configuration"/><TextBox Grid.Column="2" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" ToolTip="Name this configuration" Margin="8,0"/><Button Grid.Column="3" Content="Save setup" Command="{Binding SaveConfigurationCommand}" Margin="0"/></Grid></Border>
                        <Grid Margin="0,1,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,14,0"><TextBlock Text="Allowed apps" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="Choose the desktop tools that stay available during focus." Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Bottom"><TextBox Text="{Binding ApplicationSearch, UpdateSourceTrigger=PropertyChanged}" Width="160" ToolTip="Search apps" Margin="0,0,7,0"/><Button Content="Find running apps" Command="{Binding AddRunningApplicationsCommand}" Background="{DynamicResource SecondaryBrush}" Foreground="{DynamicResource InkBrush}"/><Button Content="Browse .exe" Command="{Binding AddApplicationCommand}" Margin="0"/></WrapPanel></Grid>
                        <Border Style="{StaticResource Card}" Padding="10"><ItemsControl ItemsSource="{Binding ApplicationView}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="4,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="4,0,12,0"/><Border Grid.Column="1" Width="34" Height="34" CornerRadius="8" Background="{DynamicResource ElevatedBrush}" Padding="3" Margin="0,0,11,0"><Image Source="{Binding Value.ExecutablePath, Converter={StaticResource ExecutableIcon}}"/></Border><StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="3" Content="Remove" Background="Transparent" Foreground="{DynamicResource MutedBrush}" Padding="10,5" MinHeight="30" Command="{Binding DataContext.RemoveApplicationCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsWebsitesSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Allowed websites" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="During focus, the extension allows these sites and blocks other web pages in Chromium browsers." Style="{StaticResource Muted}" Margin="0,5,0,18" TextWrapping="Wrap"/>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,14"><DockPanel LastChildFill="True"><Grid DockPanel.Dock="Top" Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox Text="{Binding NewWebsite, UpdateSourceTrigger=PropertyChanged}" ToolTip="Example: github.com"/><Button Grid.Column="1" Content="Add website" Command="{Binding AddWebsiteCommand}" Margin="9,0,0,0"/></Grid><ItemsControl ItemsSource="{Binding SelectedWebsites}"><ItemsControl.ItemTemplate><DataTemplate><Grid Margin="4,5"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><CheckBox IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="4,0,14,0"/><StackPanel Grid.Column="1"><TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold"/><TextBlock Text="{Binding Detail}" Style="{StaticResource Muted}"/></StackPanel><Button Grid.Column="2" Content="Remove" Background="Transparent" Foreground="{DynamicResource MutedBrush}" Command="{Binding DataContext.RemoveWebsiteCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}" Margin="0"/></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></DockPanel></Border>
                        <Border Style="{StaticResource Card}" Padding="18"><StackPanel><TextBlock Text="Browser connection" FontWeight="SemiBold"/><TextBlock Text="{Binding ExtensionStatusText}" Style="{StaticResource Muted}" Margin="0,5,0,0"/><TextBlock Text="Load the included extension in Chrome or Edge, then open its toolbar popup and choose Connect to desktop. Reload the extension after updating its files." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,8,0,0"/><Button Content="Open extension folder" Command="{Binding OpenExtensionFolderCommand}" HorizontalAlignment="Left" Margin="0,12,0,0" Background="{DynamicResource SecondaryBrush}" Foreground="{DynamicResource InkBrush}"/></StackPanel></Border>
                    </StackPanel>
                    <StackPanel Visibility="{Binding IsSettingsSelected, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="Settings" FontSize="19" FontWeight="SemiBold"/><TextBlock Text="Tune the app to fit the way you work." Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                        <Border Style="{StaticResource Card}" Margin="0,16,0,12"><StackPanel><TextBlock Text="Appearance" FontWeight="SemiBold"/><TextBlock Text="Choose a theme or follow Windows." Style="{StaticResource Muted}" Margin="0,4,0,10"/><ComboBox ItemsSource="{Binding ThemeOptions}" SelectedItem="{Binding ThemePreference}" Width="180" HorizontalAlignment="Left"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}" Margin="0,0,0,12"><StackPanel><CheckBox Content="Prevent ending sessions early" IsChecked="{Binding PreventEarlyEnd, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding CanChangeSessionLock}" FontWeight="SemiBold"/><TextBlock Text="When enabled, a focus session runs until its timer expires. Change this only between sessions." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="23,6,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="Browser integration" FontWeight="SemiBold"/><TextBlock Text="{Binding ExtensionStatusText}" Style="{StaticResource Muted}" Margin="0,5,0,18"/><TextBlock Text="Session data is saved locally and an active countdown survives closing or restarting the app." Style="{StaticResource Muted}" TextWrapping="Wrap"/><TextBlock Text="Local data" FontWeight="SemiBold" Margin="0,22,0,0"/><TextBlock Text="{Binding DatabaseLocation}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,6,0,0"/></StackPanel></Border>
                    </StackPanel>
                </Grid>
            </ScrollViewer>
            <TextBlock Grid.Row="2" Text="{Binding NoticeText}" Style="{StaticResource Muted}" Margin="0,12,0,0" TextTrimming="CharacterEllipsis"/>
        </Grid>
    </Grid>
</Window>
