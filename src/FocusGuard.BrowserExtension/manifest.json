{
  "manifest_version": 3,
  "name": "Whitelist Lock In: Website Focus",
  "version": "1.0.0",
  "description": "Enforces website focus sessions managed by Whitelist Lock In for Windows.",
  "key": "",
  "permissions": ["declarativeNetRequest", "alarms", "storage"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_title": "Whitelist Lock In",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": ["blocked.html", "blocked.css"],
      "matches": ["<all_urls>"]
    }
  ]
}

